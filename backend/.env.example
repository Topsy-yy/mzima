PROJECT_NAME="Mzima Backend"
API_V1_STR="/api/v1"
ENV="development"
DEBUG=True

# Native PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="mzima_user"
POSTGRES_PASSWORD= #yourpassword
POSTGRES_DB="mzima_db"
DATABASE_URL="postgresql://mzima_user:mzima_dev_password@localhost:5432/mzima_db"

# Security
SECRET_KEY="dev_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480