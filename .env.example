# Mzima — Environment Variables

# Copy this file to .env and fill in your values.
# Never commit .env to git.
#   cp .env.example .env
# See docs/TECH_STACK.md for the full stack overview.




# Agent Router — LLM gateway (https://agentrouter.org)
# One key from your AgentRouter dashboard covers all surfaces.
# No separate Anthropic account needed.
# Get your key: https://agentrouter.org → API Token → Add → Unlimited quota

AGENTROUTER_API_KEY=sk-your-agentrouter-key-here

# Base URL for all model requests through Agent Router
# Models are selected by name — switch models by changing MODEL_NAME only
BASE_URL=https://agentrouter.org/v1
MODEL_NAME=claude-opus-4-8

# The same key is used for all requests
OPENAI_API_KEY=${AGENTROUTER_API_KEY}



# Database — Neon (PostgreSQL, serverless)
# Create a project at https://neon.tech, copy the connection string from the
# dashboard. Use a separate branch per developer (Neon → Branches → New branch).


# Pooled connection (use for app / API)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct connection (use for Prisma migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require



# FastAPI — backend


API_HOST=0.0.0.0
API_PORT=8000

# Generate with: openssl rand -hex 32
API_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Environment: development | test | production
APP_ENV=development

# CORS — origins allowed to call the API (space-separated)
CORS_ORIGINS=http://localhost:3000

# Clinician approval gate
# One-time approval tokens signed with this secret
# Generate with: openssl rand -hex 32


APPROVAL_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32
APPROVAL_TOKEN_EXPIRE_SECONDS=300



# Next.js, frontend


NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth.js v5
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000



# Audit log


AUDIT_LOG_PATH=./logs/audit.jsonl



# Voice / TTS — ElevenLabs (optional)
# Generic, non-personal prompts only ("Please wait for staff" etc.)
# Read MZIMA_SYSTEM_DESIGN.md data sovereignty note before enabling.

# ELEVENLABS_API_KEY=your-elevenlabs-key-here



# Clinic HMIS adapter (prototype — points at local mock)


CLINIC_ADAPTER_URL=http://localhost:8001
CLINIC_ADAPTER_API_KEY=mock-key-for-local-dev
