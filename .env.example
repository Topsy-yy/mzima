# Local development settings for the current FastAPI application.
# Copy to .env and replace the password and secret before starting.

PROJECT_NAME="Mzima Backend"
API_V1_STR="/api/v1"
ENV="development"
DEBUG=True
DATABASE_URL="postgresql://mzima_user:replace-this-local-password@localhost:5432/mzima_db"

SECRET_KEY="replace-with-a-random-development-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
