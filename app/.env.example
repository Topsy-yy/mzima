PROJECT_NAME="Mzima Backend"
API_V1_STR="/api/v1"
ENV="development"
DEBUG=True

# Synthetic local prototype database. Use a secured PostgreSQL DATABASE_URL for deployment.
DATABASE_URL="sqlite:///./mzima.db"

# Optional; omit for a fresh random development-only signing key.
# Set a strong, private value for deployments.
# SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional local-only agent. Keep disabled until an approved local model is running.
LOCAL_AGENT_ENABLED=False
LOCAL_MODEL_BASE_URL="http://127.0.0.1:11434/v1"
# Set this to a model already installed in your local Ollama instance.
LOCAL_MODEL_NAME=""
LOCAL_MODEL_API_KEY="local"
LOCAL_MODEL_TIMEOUT_SECONDS=20
MCP_SERVER_COMMAND="python"
MCP_SERVER_ARGS="-m app.mcp.server"
